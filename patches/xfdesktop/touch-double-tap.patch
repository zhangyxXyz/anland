+
+/* Touch contacts can land at different points of the same icon. Gtk's mouse
+ * distance threshold (often 5 px) must not split those into unrelated taps.
+ * Keep the configured double-click time, but pair completed taps by target.
+ * Existing drag handling still owns movement and can deny this observer. */
+static ViewItem *
+xfdesktop_icon_view_touch_item(XfdesktopIconView *icon_view, gdouble x, gdouble y) {
+    GdkEventButton hit = { 0 };
+    hit.x = x;
+    hit.y = y;
+    GList *item_l = g_list_find_custom(icon_view->items, &hit,
+                                     (GCompareFunc)xfdesktop_check_icon_clicked);
+    return item_l != NULL ? item_l->data : NULL;
+}
+
+static const GdkEvent *
+xfdesktop_icon_view_touch_event(GtkGestureMultiPress *gesture) {
+    GdkEventSequence *sequence = gtk_gesture_single_get_current_sequence(GTK_GESTURE_SINGLE(gesture));
+    return gtk_gesture_get_last_event(GTK_GESTURE(gesture), sequence);
+}
+
+static void
+xfdesktop_icon_view_touch_cancel(GtkGesture *gesture,
+                                 GdkEventSequence *sequence,
+                                 XfdesktopIconView *icon_view) {
+    icon_view->touch_pressed_item = NULL;
+    icon_view->touch_previous_item = NULL;
+}
+
+static void
+xfdesktop_icon_view_touch_pressed(GtkGestureMultiPress *gesture,
+                                  gint n_press, gdouble x, gdouble y,
+                                  XfdesktopIconView *icon_view) {
+    const GdkEvent *event = xfdesktop_icon_view_touch_event(gesture);
+    icon_view->touch_pressed_item = xfdesktop_icon_view_touch_item(icon_view, x, y);
+    icon_view->touch_pressed_time = event != NULL ? gdk_event_get_time(event) : 0;
+    if (icon_view->touch_pressed_item != icon_view->touch_previous_item)
+        icon_view->touch_previous_item = NULL;
+}
+
+static void
+xfdesktop_icon_view_touch_released(GtkGestureMultiPress *gesture,
+                                   gint n_press, gdouble x, gdouble y,
+                                   XfdesktopIconView *icon_view) {
+    const GdkEvent *event = xfdesktop_icon_view_touch_event(gesture);
+    GdkModifierType state = 0;
+    if (event != NULL)
+        gdk_event_get_state(event, &state);
+    guint32 now = event != NULL ? gdk_event_get_time(event) : 0;
+    gint double_click_time = 0;
+    g_object_get(gtk_widget_get_settings(GTK_WIDGET(icon_view)),
+                 "gtk-double-click-time", &double_click_time, NULL);
+    ViewItem *item = xfdesktop_icon_view_touch_item(icon_view, x, y);
+    if (event == NULL || event->type != GDK_TOUCH_END || icon_view->single_click
+        || icon_view->definitely_dragging || icon_view->definitely_rubber_banding
+        || (state & (GDK_CONTROL_MASK | GDK_SHIFT_MASK)) != 0
+        || item == NULL || item != icon_view->touch_pressed_item || item != icon_view->cursor
+        || (guint32)(now - icon_view->touch_pressed_time) > (guint)double_click_time) {
+        icon_view->touch_previous_item = NULL;
+        icon_view->touch_pressed_item = NULL;
+        return;
+    }
+
+    gboolean activate = item == icon_view->touch_previous_item
+        && (guint32)(icon_view->touch_pressed_time - icon_view->touch_previous_time) <= (guint)double_click_time;
+    icon_view->touch_previous_item = activate ? NULL : item;
+    icon_view->touch_previous_time = icon_view->touch_pressed_time;
+    icon_view->touch_pressed_item = NULL;
+    if (activate) {
+        /* Clear state before emission: activation can change the model. */
+        xfdesktop_icon_view_clear_drag_event(icon_view);
+        g_signal_emit(G_OBJECT(icon_view), __signals[SIG_ICON_ACTIVATED], 0);
+        xfdesktop_icon_view_unselect_all(icon_view);
+    }
 }
 
