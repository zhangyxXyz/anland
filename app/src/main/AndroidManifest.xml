<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false">

        <!-- Launcher entry: window list (Attached/Detached state) -->
        <activity android:name=".MainActivity" android:exported="true" android:theme="@style/Theme.MaterialDesignShell">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- wayland windows are hosted by com.anlandnext.awl.AwlWindowActivity,
             merged in from the libawl library module (same code third-party
             consumer apps run) -->

        <!-- Window behavior settings -->
        <activity android:name=".WlSettingsActivity" android:exported="false" android:theme="@style/Theme.MaterialDesignShell"/>
        <!-- Daemon NEW_TASK requests must not front the window-list task under
             this transparent coordinator. Shell's in-task handoff stays local. -->
        <activity android:name=".OpenWindowActivity" android:exported="true"
                  android:theme="@style/Theme.AnlandLaunch"
                  android:taskAffinity="${applicationId}.launch"
                  android:excludeFromRecents="true"/>
        <provider android:name=".SessionWindowsProvider" android:authorities="com.anlandnext.sessions" android:exported="true"/>

        <!-- client closed its own window → daemon notification finishes the Activity -->
        <receiver android:name=".WindowGoneReceiver" android:exported="true">
            <intent-filter>
                <action android:name="anland.WINDOW_GONE"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
