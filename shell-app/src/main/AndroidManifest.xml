<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.anlandnext"/></queries>
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Legacy fallback for launchers without pin-shortcut support. -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Launcher entry: containers + Linux app grid. -->
        <activity android:name=".ShellActivity" android:exported="true" android:theme="@style/Theme.MaterialDesignShell">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Selected-user console: ViewModel retains `run sh` across rotation. -->
        <activity android:name=".ConsoleActivity" android:exported="false"
                  android:theme="@style/Theme.MaterialDesignShell"/>
        <activity android:name=".connections.CredentialsActivity" android:exported="false"
                  android:theme="@style/Theme.MaterialDesignShell"/>

        <!-- Entry point for pinned home-screen shortcuts (explicit intents
             only, so no intent-filter): ensures the container is running,
             then launches the app detached inside it. -->
        <activity android:name=".AppLaunchActivity" android:exported="true"
                  android:theme="@style/Theme.AnlandLaunch"
                  android:excludeFromRecents="true"/>
    </application>
</manifest>
